# Copy to .env and change the passwords. Never commit .env.
MARIADB_ROOT_PASSWORD=change-me-root
MW_DB_PASSWORD=change-me-mw
WTM_IMPORTER_PASSWORD=change-me-importer
WTM_READER_PASSWORD=change-me-reader
MW_ADMIN_PASSWORD=change-me-admin-password-123

# Required ONLY for live fetches from the Wikimedia API (fixture mode works offline).
# Wikimedia User-Agent policy: identify the tool and give a way to contact you.
# Example: WikiTimeMachine/0.1 (https://example.org/your-page; you@example.org)
WTM_USER_AGENT=

# Optional grounded answer synthesis (any OpenAI-compatible chat endpoint, e.g. NVIDIA NIM Nemotron).
# Leave WTM_LLM_BASE_URL empty to disable generation; diff and retrieved evidence still work.
# Hackathon Nemotron (Verda/DataCrunch, vLLM, OpenAI-compatible):
#   WTM_LLM_BASE_URL=https://containers.datacrunch.io/nemotron-3-5-super-vl-b300/v1
#   WTM_LLM_MODEL=nemotron-3.5-super-vl
WTM_LLM_BASE_URL=
WTM_LLM_MODEL=
WTM_LLM_API_KEY=
WTM_LLM_TIMEOUT=120
WTM_LLM_MAX_TOKENS=6000
# Optional JSON merged into the request body, e.g. {"chat_template_kwargs": {"enable_thinking": false}}
WTM_LLM_EXTRA_BODY=
# 1 = send a per-request JSON schema (vLLM structured outputs) restricting each side to its own snippet IDs
WTM_LLM_STRUCTURED=1
# Extra body for claim extraction only (default disables reasoning for this copy-and-classify task)
# WTM_LLM_EXTRACT_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
